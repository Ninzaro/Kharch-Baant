# Copy to android/keystore.properties (gitignored) and fill in.
# Generate a keystore once and back it up offline — losing it means you cannot update the Play listing.
#
#   keytool -genkeypair -v -keystore kharch-baant-release.keystore -alias kharch-baant -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=kharch-baant-release.keystore
storePassword=replace-me
keyAlias=kharch-baant
keyPassword=replace-me
