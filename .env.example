# Copy to .env.local and fill in. Never commit .env.local.
# Restart `npm run dev` after changes.

# ── Required (client — public by design) ─────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Clerk publishable key only (pk_test_… for dev, pk_live_… for production)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Optional app origin used in email deep links
# VITE_APP_URL=https://your-domain.com

# ── DO NOT put these in VITE_* (server / Edge secrets only) ───────────────────
# Set via Supabase Dashboard → Edge Functions → Secrets (or `supabase secrets set`):
#
#   MAILERSEND_API_KEY=mlsn....
#   MAILERSEND_FROM_EMAIL=noreply@your-domain.com
#   GEMINI_API_KEY=AIza...
#   GEMINI_MODEL=gemini-2.0-flash
#   CLERK_SECRET_KEY=sk_live_...          # native-bridge only
#   CLERK_PUBLISHABLE_KEY=pk_live_...     # native-bridge authenticateRequest()
#   ALLOWED_ORIGINS=https://www.motamaati.in,https://motamaati.in
#
# Also never commit:
#   SUPABASE_SERVICE_ROLE_KEY
#   Clerk secret keys (sk_...)

# ── Optional client flags ────────────────────────────────────────────────────
# VITE_API_MODE=supabase
# VITE_DEBUG_ENABLED=false
